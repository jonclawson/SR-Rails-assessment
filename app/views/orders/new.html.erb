<div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <!-- Header -->
  <div class="mb-8">
    <div class="flex items-center gap-3 mb-2">
      <%= link_to orders_path, class: "text-gray-400 hover:text-gray-500" do %>
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
      <% end %>
      <h1 class="text-3xl font-bold text-gray-900">Create New Order</h1>
    </div>
    <p class="text-gray-600">Add products and quantities to create a new order. The order will start in pending status.</p>
  </div>

  <!-- Form -->
  <%= render "form", order: @order, products: @products %>
</div>
