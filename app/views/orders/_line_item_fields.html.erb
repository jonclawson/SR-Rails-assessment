<div class="line-item-row flex gap-3 items-start p-4 bg-gray-50 rounded-md">
  <%= form.hidden_field :_destroy, value: "0" %>
  
  <div class="flex-1">
    <label class="block text-sm font-medium text-gray-700 mb-1">Product</label>
    <%= form.select :product_id, 
                    options_from_collection_for_select(products, :id, 
                      ->(p) { "#{p.name} (#{p.sku}) - #{p.formatted_price}" }, 
                      form.object.product_id),
                    { prompt: "Select a product..." },
                    { class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm",
                      onchange: "updateOrderTotals()" } %>
  </div>
  
  <div class="w-32">
    <label class="block text-sm font-medium text-gray-700 mb-1">Quantity</label>
    <%= form.number_field :quantity, 
                          value: form.object.quantity || 1,
                          min: 1,
                          class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm",
                          onchange: "updateOrderTotals()" %>
  </div>
  
  <div class="pt-7">
    <button type="button" 
            class="remove-line-item text-red-600 hover:text-red-800"
            onclick="removeLineItem(this)">
      <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
      </svg>
    </button>
  </div>
</div>
