<% if order.tracking_events.any? %>
  <div class="flow-root">
    <ul class="-mb-8">
      <% order.tracking_events.order(occurred_at: :desc).each_with_index do |event, index| %>
        <li>
          <div class="relative pb-8">
            <% unless index == order.tracking_events.size - 1 %>
              <span class="absolute top-4 left-4 -ml-px h-full w-0.5 bg-gray-200" aria-hidden="true"></span>
            <% end %>
            <div class="relative flex space-x-3">
              <div>
                <span class="h-8 w-8 rounded-full <%= event.event_type == 'delivered' ? 'bg-green-500' : 'bg-indigo-500' %> flex items-center justify-center ring-8 ring-white">
                  <svg class="h-5 w-5 text-white" fill="currentColor" viewBox="0 0 20 20">
                    <% if event.event_type == 'delivered' %>
                      <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                    <% else %>
                      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"/>
                    <% end %>
                  </svg>
                </span>
              </div>
              <div class="min-w-0 flex-1 pt-1.5 flex justify-between space-x-4">
                <div>
                  <p class="text-sm font-medium text-gray-900"><%= event.description %></p>
                  <p class="text-sm text-gray-500"><%= event.location %> • <%= event.carrier %></p>
                </div>
                <div class="text-right text-sm whitespace-nowrap text-gray-500">
                  <time datetime="<%= event.occurred_at.iso8601 %>">
                    <%= event.occurred_at.strftime("%b %d, %I:%M %p") %>
                  </time>
                </div>
              </div>
            </div>
          </div>
        </li>
      <% end %>
    </ul>
  </div>
<% else %>
  <p class="text-sm text-gray-500 text-center py-4">No tracking events yet. Events will appear here once the carrier provides tracking updates.</p>
<% end %>
